# ReelToReal Environment Configuration
# Paste your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# Temporary storage directory for uploaded/downloaded videos
TEMP_VIDEO_DIR=./tmp/videos

# Optional persistent data directory (for Docker / Cloud persistent disks, e.g. /app/data or /var/data)
# DATA_DIR=./data

# Optional server port (set automatically by cloud providers like Render, Railway, Fly.io)
# PORT=8000
